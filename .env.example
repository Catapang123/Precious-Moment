# App
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string

# Supabase — required for the real site (production refuses to start without it)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public Supabase Storage bucket for product images. Required in production.
SUPABASE_STORAGE_BUCKET=product-images
# Set to 1 only when the app is behind one trusted reverse proxy (Render).
TRUST_PROXY=0

# Test fixtures only. Keep false for the live site.
SEED_DEMO=false

# Branch routing
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_ENABLED=true
BRANCH_TIE_KM=0.25

# Product images uploaded from Product images in the dashboard
UPLOAD_DIR=public/uploads/products

# Self-service password recovery. Links expire after 30 minutes.
# Create a Resend key at https://resend.com/api-keys. Without it, local runs
# print the reset link to the terminal and production cannot deliver email.
# MAIL_FROM must use a domain verified in Resend. For testing only,
# onboarding@resend.dev delivers solely to the Resend account owner's address.
PASSWORD_RESET_TTL_MINUTES=30
RESEND_API_KEY=
MAIL_FROM=Precious Moments <hello@preciousmoments.ph>

# Customer design uploads (optional). Production uses a PRIVATE Supabase bucket.
# SUPABASE_BOOKING_BUCKET=booking-files
# BOOKING_FILE_DIR=data/booking-files
# BOOKING_FILE_MAX_BYTES=10485760
# BOOKING_FILES_PER_BOOKING=8
