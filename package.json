{
  "name": "precious-moments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Precious Moments booking, payment, and operations platform",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "report": "node scripts/report.mjs",
    "report:py": "python scripts/report.py",
    "setup": "node scripts/bootstrap.mjs",
    "setup:branches": "node scripts/setup-branches.mjs",
    "sync:prices": "node scripts/sync-prices.mjs",
    "test": "node scripts/smoke.mjs",
    "build:shop": "vite build --config client/vite.config.js",
    "dev:shop": "vite --config client/vite.config.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.11"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.68.3"
  }
}
